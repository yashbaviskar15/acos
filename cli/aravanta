#!/usr/bin/env sh
# Aravanta Cloud OS CLI Launcher for macOS and Linux
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$SCRIPT_DIR/aravanta.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$SCRIPT_DIR/aravanta.py" "$@"
else
    echo "Error: Python 3 is required to run aravanta CLI." >&2
    exit 1
fi
