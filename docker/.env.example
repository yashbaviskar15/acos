# ─────────────────────────────────────────────────────────────────────────
# Aravanta CloudOS — production environment for the Docker stack
#
#   1. Copy this file to `.env` IN THIS FOLDER:   cp .env.example .env
#   2. Replace every REPLACE_ME value below with a strong secret.
#   3. `docker compose` auto-loads docker/.env. NEVER commit the real .env
#      (it is git-ignored); only this .example file is committed.
# ─────────────────────────────────────────────────────────────────────────

# JWT signing key. arvgate signs tokens with it and every service verifies
# with it, so all services must share the same value.
#   Generate:  openssl rand -hex 32
ARVGATE_JWT_SECRET_KEY=REPLACE_ME_openssl_rand_hex_32

# PostgreSQL password. Used by the postgres container AND by arvgate's database
# URL (wired together in docker-compose.prod.yml).
#   Generate:  openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME_strong_db_password

# Grafana admin login (monitoring dashboard, internal only).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME_strong_grafana_password

# Public domain for automatic HTTPS via the Caddy reverse proxy (prod override).
# Create a DNS A record for this domain pointing at your server's public IP first.
DOMAIN=cloudos.example.com
