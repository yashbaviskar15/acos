# Keep host build artifacts out of the Docker image build.
# frontend/Dockerfile runs `npm install` INSIDE the container and then `COPY . .`.
# Without this file, a host node_modules (built for a different OS/arch) would be
# copied over the container's fresh install and break `tsc`/`vite build`.
node_modules
dist
.vite
*.log
npm-debug.log*

# VCS / local / meta
.git
.gitignore
.env
.env.*
.dockerignore
Dockerfile
