# ─────────────────────────────────────────────────────────────────────────
# Aravanta CloudOS — Backend Environment Variables (.env)
#
#   1. Copy this file to `.env` in the `backend/` directory:  cp .env.example .env
#   2. Replace placeholder values with secure, environment-specific secrets.
#   3. NEVER commit `.env` into version control.
# ─────────────────────────────────────────────────────────────────────────

# [REQUIRED] Cryptographic JWT Signing Key (HS256)
# Minimum 32 characters. Cannot be default placeholders.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_generate_with_secrets_token_urlsafe_64

# [REQUIRED FOR PRODUCTION] PostgreSQL Connection String
# Serverless / Production: External Postgres (Neon, Supabase, AWS RDS, etc.)
# Local Development default fallback: sqlite:///./data/aravanta_dev.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/aravanta_cloudos

# Environment Name: 'local', 'development', 'staging', 'production'
# On serverless (Vercel / AWS Lambda), setting ENVIRONMENT=local is rejected.
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=https://aravantacos.vercel.app,https://arv-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# Token Expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Optional: Redis URL for distributed rate limiting and caching
REDIS_URL=redis://localhost:6379/0

# [OPTIONAL / LOCAL ONLY] Master bypass TOTP codes (comma-separated).
# Rejected and raises fatal error if ENVIRONMENT is not explicitly 'local'
# or if running in serverless (VERCEL / AWS_LAMBDA).
# MFA_DEV_MASTER_CODES=123456
